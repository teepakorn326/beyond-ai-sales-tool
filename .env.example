# ---- AWS (ap-southeast-2): fill from infra/aws/bootstrap.sh -------------
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Claude through Bedrock. Model ids are APAC inference-profile ids.
AI_PROVIDER=bedrock
ANTHROPIC_MODEL=apac.anthropic.claude-sonnet-...
ANTHROPIC_CLASSIFY_MODEL=apac.anthropic.claude-haiku-...
AGENT_MODEL=apac.anthropic.claude-sonnet-...

# Embeddings through Bedrock (Cohere Embed Multilingual v3, 1024 dims).
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL=cohere.embed-multilingual-v3
EMBEDDING_DIMS=1024

# Document images: private bucket, no public access, no presigned URLs.
S3_BUCKET=vdc-demo-documents-<account-id>
S3_KMS_KEY_ID=

# RDS Postgres 16 with pgvector. sslmode=require encrypts; set
# PG_CA_CERT_PATH to the RDS CA bundle to also verify the certificate.
DATABASE_URL=postgresql://app:<password>@<endpoint>.rds.amazonaws.com:5432/app?sslmode=require
PG_CA_CERT_PATH=

# Duplicate-student detection hashes (surname, given name, DOB) with this
# salt; the values themselves are never stored. Unset disables the feature.
IDENTITY_HASH_SALT=
SIMILAR_MIN_SIMILARITY=0.80
DAILY_TOKEN_BUDGET=400000

# Host-side URLs for ./run.sh dev / ask (compose overrides these per service).
RULES_SERVICE_URL=http://localhost:8081
EXTRACTOR_URL=http://localhost:8000

# ---- direct APIs instead of Bedrock (optional) ---------------------------
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small

# ---- offline (./run.sh dev, no AWS): docker compose --profile local -------
# DATABASE_URL=postgresql://app:app@localhost:5432/app
# S3_BUCKET=vdc-documents
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=minio
# AWS_SECRET_ACCESS_KEY=minio-local-secret
