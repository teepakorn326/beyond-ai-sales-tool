# Offline stack: every value here is a local default, nothing is a secret.
# Used by `./run.sh local` as the compose interpolation file, so a clone runs
# with Docker alone: no .env, no AWS account, no API key, no Go/Node/Python.
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio-local-secret
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AGENT_MODEL=
DATABASE_URL=postgresql://app:app@db:5432/app
PG_CA_CERT_PATH=
S3_BUCKET=vdc-documents
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_KMS_KEY_ID=
IDENTITY_HASH_SALT=local-dev-salt-not-for-production
SIMILAR_MIN_SIMILARITY=0.70
