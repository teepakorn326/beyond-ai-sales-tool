{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DocumentBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::BUCKET_NAME/*"
    },
    {
      "Sid": "DocumentBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::BUCKET_NAME"
    },
    {
      "Sid": "DescribeForAllowMyIp",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances",
        "ec2:DescribeSecurityGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowMyIpOnDbSecurityGroup",
      "Effect": "Allow",
      "Action": "ec2:AuthorizeSecurityGroupIngress",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:security-group/DB_SECURITY_GROUP_ID"
    },
    {
      "Sid": "BedrockModels",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel"
      ],
      "Resource": [
        "arn:aws:bedrock:REGION::foundation-model/cohere.embed-multilingual-v3",
        "arn:aws:bedrock:*::foundation-model/anthropic.*",
        "arn:aws:bedrock:REGION:ACCOUNT_ID:inference-profile/au.anthropic.*",
        "arn:aws:bedrock:REGION:ACCOUNT_ID:inference-profile/apac.anthropic.*"
      ]
    }
  ]
}
